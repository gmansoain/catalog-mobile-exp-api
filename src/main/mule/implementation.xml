<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="listProducts" doc:id="1fc83c84-3483-45a4-8ce4-3d9dfc8be636" >
		<http:request method="GET" doc:name="GET /producst from Products API" doc:id="0aad8855-3521-4b48-8dab-acc9f81d3861" config-ref="Products_Process_API" path="/products"/>
		<ee:transform doc:name="Transform Message" doc:id="1e50b850-98ea-4bbf-a2fe-9af369a7d4f2" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var typeByCategory = {
    "GMS": "games",
    "SMP": "smartphones",
    "TEV": "televisions",
    "CAM": "cameras"
}
---
payload map ((product) -> {
    name: product.productName,
    url: product.imageUrl,
    ("type"):  typeByCategory[product.categoryCode default ""] default lower(product.categoryLabel default ""),
    price: product.price.amount
}

)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
